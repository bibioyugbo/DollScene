{
  "name": "dollscene-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "sync-shared": "node -e \"const fs=require('fs');fs.rmSync('src/shared',{recursive:true,force:true});fs.cpSync('../src/shared','src/shared',{recursive:true})\"",
    "build": "npm run sync-shared && tsc -p tsconfig.json",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "seed": "npm run build && node lib/seed.js"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
