{
  "name": "dollscene",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.studio.config.ts",
    "build": "tsc -p tsconfig.studio.json && tsc -p tsconfig.node.json && vite build --config vite.studio.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config vite.studio.config.ts",
    "test:logic": "npm --prefix functions run build && node scripts/logic-test.cjs",
    "catalog": "node scripts/generate-catalog.mjs",
    "dev:studio": "vite --config vite.studio.config.ts",
    "build:studio": "tsc -p tsconfig.studio.json && tsc -p tsconfig.node.json && vite build --config vite.studio.config.ts",
    "preview:studio": "vite preview --config vite.studio.config.ts",
    "character": "/Applications/Blender.app/Contents/MacOS/Blender -b --python scripts/character/build_character.py -- .character-build && scripts/character/optimize.sh .character-build",
    "test:vatar": "npm --prefix functions run build && node scripts/vatar-test.cjs",
    "dev:app": "vite",
    "build:app": "tsc -b && vite build",
    "preview:app": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-virtual": "^3.14.13",
    "firebase": "^13.0.0",
    "framer-motion": "^14.0.0",
    "maath": "^0.10.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
