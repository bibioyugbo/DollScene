# Copy to .env.local and fill in. With no Firebase keys the game runs on the
# offline backend (localStorage + IndexedDB, synced across tabs) so everything
# works locally without any setup.

# Product name shown in the UI.
VITE_APP_NAME=DollScene

# "local" forces the offline backend even when Firebase keys are present.
# VITE_BACKEND=local

# Firebase web app config (Project settings → General → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web push (Project settings → Cloud Messaging → Web Push certificates).
VITE_FIREBASE_VAPID_KEY=

# Region your Cloud Functions are deployed to (must match functions/src/index.ts).
VITE_FUNCTIONS_REGION=europe-west1

# Point the app at the local Firebase emulators (firebase emulators:start).
VITE_USE_EMULATORS=false

# Real label names (Meji Meji, Bolapsd, J Bottoms, Yati) show by default, marked
# "licence pending". Set to true to show fictional labels until permission is signed.
VITE_USE_FICTIONAL_BRANDS=false

# Optional 18+ cosmetic clinic in the customizer.
VITE_ENABLE_CLINIC=true
